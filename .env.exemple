# Postgres
POSTGRES_USER=voiceapp
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=voiceapp_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_DEFAULT_USER=voiceapp
RABBITMQ_DEFAULT_PASS=changeme_strong_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5671
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USE_TLS=true

# MinIO
MINIO_ROOT_USER=voiceapp
MINIO_ROOT_PASSWORD=changeme_strong_password
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_SECURE=true

# Internal CA used to verify MinIO + RabbitMQ TLS certs (baked into images)
CA_CERT_PATH=/etc/ssl/certs/voiceapp-ca.crt

# Auth
JWT_SECRET_KEY=E956500A38071ECCC2B16098362CE742A98576058AADC59F6378DDC80FA9171B

JWT_ALGORITHM=HS256

JWT_EXPIRE_MINUTES=120

PRE_AUTH_EXPIRE_MINUTES=5

TOTP_ISSUER=Alzheimer Voice Platform

AUDIO_MASTER_KEY=x8dQ1/5Ya011NKEzWcgyD+VRtkdxpKaNMo6CWAcFs34=

AUTH_SERVICE_URL=http://auth-service:8000

# CORS: comma-separated list of allowed frontend origins, no trailing slash,
